# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y completa con tus valores reales:
# cp .env.example .env
#
# ⚠️ ADVERTENCIA DE SEGURIDAD:
# NUNCA compartas ni subas tu archivo '.env' real a ningún repositorio público o privado.
# ==============================================================================

# --- Exchange (CCXT) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=tu_exchange_api_key_aqui
EXCHANGE_API_SECRET=tu_exchange_api_secret_aqui
EXCHANGE_TESTNET=true

# --- Notificaciones y Control Vía Telegram ---
# Token provisto por @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
# Chat ID numérico del usuario autorizado (obtenible vía @userinfobot en Telegram)
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui

# --- Notificaciones por Correo Electrónico (Opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_RECIPIENT=tu_correo_destino@gmail.com

# --- Persistencia y Base de Datos (RAM tmpfs + Sincronización) ---
DATABASE_URL=sqlite:////dev/shm/tradingbot.db
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_PROVIDER=turso
CLOUD_SYNC_URL=
CLOUD_SYNC_AUTH_TOKEN=
CLOUD_SYNC_INTERVAL_SECONDS=600

# --- Configuración General del Entorno ---
ENVIRONMENT=development
LOG_LEVEL=INFO
PAPER_TRADING=true
# BASE_LOG_DIR=~/.log
